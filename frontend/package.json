{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:e2e",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test tests/authentication.spec.js",
    "test:e2e:module": "playwright test tests/teleconsult-modules.spec.js",
    "test:e2e:auth": "playwright test tests/authentication.spec.js",
    "test:e2e:profile": "playwright test tests/teleconsult-modules.spec.js -g '02 patient profile'",
    "test:e2e:discovery": "playwright test tests/teleconsult-modules.spec.js -g '03 doctor discovery'",
    "test:e2e:booking": "playwright test tests/teleconsult-modules.spec.js -g '04 booking'",
    "test:e2e:payment": "playwright test tests/teleconsult-modules.spec.js -g '05 sandbox payment'",
    "test:e2e:doctor": "playwright test tests/teleconsult-modules.spec.js -g '06 doctor portal'",
    "test:e2e:webrtc": "playwright test tests/teleconsult-modules.spec.js -g '07 WebRTC'",
    "test:e2e:completion": "playwright test tests/teleconsult-modules.spec.js -g '08 consultation completion'",
    "test:e2e:security": "playwright test tests/teleconsult-modules.spec.js -g '09 security'",
    "test:e2e:live": "playwright test --config=playwright.live.config.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "vite": "^8.3.5"
  }
