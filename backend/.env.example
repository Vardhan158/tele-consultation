TELECONSULT_ENVIRONMENT=dev
# Use managed identity / vault in real environments. Never commit real credentials.
TELECONSULT_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/teleconsult
TELECONSULT_MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:migrator@localhost:5432/teleconsult
TELECONSULT_TENANCY_MODE=pooled
TELECONSULT_AUTH_METHOD=password
TELECONSULT_PAYMENT_MODE=clinic_specific
TELECONSULT_INTAKE_POLICY=clinic_configured
TELECONSULT_PRESCRIPTIONS_ENABLED=false
TELECONSULT_VIDEO_PROVIDER=unconfigured
TELECONSULT_VIDEO_JOIN_WINDOW_MINUTES=30
TELECONSULT_AUDIO_ONLY_ALLOWED=false
TELECONSULT_CANCELLATION_DEADLINE_HOURS=24
TELECONSULT_MAX_RESCHEDULES=1
TELECONSULT_MOBILE_LAUNCH_MODE=responsive_web
TELECONSULT_CLINICAL_RECORD_RETENTION_DAYS=2555
TELECONSULT_CLINIC_MODEL=clinic_network
FRONTEND_ORIGINS=http://localhost:5173

# Newsletter email delivery. Keep secrets server-side; set HTTPS URLs in deployment.
NEWSLETTER_WEBSITE_URL=https://your-public-kaizen-care-domain.example
NEWSLETTER_API_BASE_URL=https://your-api-domain.example
NEWSLETTER_POSTER_URL=https://your-public-kaizen-care-domain.example/assets/kaizen-care-poster.png
NEWSLETTER_TOKEN_TTL_MINUTES=60
NEWSLETTER_RATE_LIMIT_PER_HOUR=5

# MongoDB Atlas (use Render secrets for the URI; never commit it)
MONGODB_ENABLED=false
MONGODB_URI=
MONGODB_DATABASE=kaizentrix_care

# Clinic Administrator Credentials
CLINIC_ADMIN_EMAIL=clinic-admin@teleconsult.local
CLINIC_ADMIN_PASSWORD=AdminPassword123!

# Cloudinary Image Storage (Profile Avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or provide the combined URL:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

