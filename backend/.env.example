TELECONSULT_ENVIRONMENT=dev
# Use managed identity / vault in real environments. Never commit real credentials.
TELECONSULT_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/teleconsult
TELECONSULT_MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:migrator@localhost:5432/teleconsult
TELECONSULT_TENANCY_MODE=pooled
TELECONSULT_AUTH_METHOD=password
TELECONSULT_PAYMENT_MODE=clinic_specific
TELECONSULT_INTAKE_POLICY=clinic_configured
TELECONSULT_PRESCRIPTIONS_ENABLED=false
TELECONSULT_VIDEO_PROVIDER=unconfigured
TELECONSULT_VIDEO_JOIN_WINDOW_MINUTES=30
TELECONSULT_AUDIO_ONLY_ALLOWED=false
TELECONSULT_CANCELLATION_DEADLINE_HOURS=24
TELECONSULT_MAX_RESCHEDULES=1
TELECONSULT_MOBILE_LAUNCH_MODE=responsive_web
TELECONSULT_CLINICAL_RECORD_RETENTION_DAYS=2555
TELECONSULT_CLINIC_MODEL=clinic_network
