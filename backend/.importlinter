[importlinter]
root_package = teleconsult
include_external_packages = True

[importlinter:contract:kernel-is-independent]
name = Kernel must not import modules or adapters
type = forbidden
source_modules = teleconsult.kernel
forbidden_modules =
    teleconsult.modules
    teleconsult.adapters

[importlinter:contract:modules-not-adapters]
name = Modules depend on ports, never on adapters
type = forbidden
source_modules = teleconsult.modules
forbidden_modules = teleconsult.adapters

[importlinter:contract:untrusted-worker-no-db]
name = Untrusted worker has no database or business-module access
type = forbidden
source_modules = teleconsult.worker_untrusted
forbidden_modules =
    teleconsult.kernel.db
    teleconsult.modules
    sqlalchemy
    asyncpg
    psycopg

[importlinter:contract:public-api-only-identity]
name = Only api.py of identity may be imported by other modules
type = forbidden
allow_indirect_imports = True
source_modules =
    teleconsult.modules.tenancy
    teleconsult.modules.directory
    teleconsult.modules.scheduling
    teleconsult.modules.consultation
    teleconsult.modules.records
    teleconsult.modules.consent
    teleconsult.modules.payments
    teleconsult.modules.notifications
    teleconsult.modules.reporting
    teleconsult.modules.support_access
    teleconsult.modules.audit
forbidden_modules =
    teleconsult.modules.identity.routes
    teleconsult.modules.identity.service
    teleconsult.modules.identity.domain
    teleconsult.modules.identity.models
    teleconsult.modules.identity.repo
    teleconsult.modules.identity.permissions
    teleconsult.modules.identity.events
    teleconsult.modules.identity.schemas
    teleconsult.modules.identity.ports

[importlinter:contract:layers-identity]
name = Layering inside identity: routes -> service -> repo
type = layers
layers =
    teleconsult.modules.identity.routes
    teleconsult.modules.identity.service
    teleconsult.modules.identity.repo

